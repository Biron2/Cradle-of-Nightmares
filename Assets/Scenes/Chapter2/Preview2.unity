  - {fileID: 21300000, guid: 24e7e6ad16ea8c74597f0288328a4d23, type: 3}
  texts:
  - "\u0410\u043D\u0442\u0438\u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435
    \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438
    (\u0410\u0420\u041B) \u2014\r\n\u044D\u0442\u043E \u043F\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E, \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0437\u0443\u044E\u0449\u0435\u0435\u0441\u044F
    \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u043C \u043F\u0440\u0435\u043D\u0435\u0431\u0440\u0435\u0436\u0435\u043D\u0438\u0435\u043C
    \u043A \u043F\u0440\u0430\u0432\u0430\u043C \u0434\u0440\u0443\u0433\u0438\u0445
    \u043B\u044E\u0434\u0435\u0439 \u0438 \u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u043C
    \u043D\u043E\u0440\u043C\u0430\u043C.\r\n\u041B\u044E\u0434\u0438 \u0441 \u0434\u0430\u043D\u043D\u044B\u043C
    \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E\u043C
    \u0447\u0430\u0441\u0442\u043E \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u044E\u0442
    \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u043E\u0435, \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u0438\u0432\u043D\u043E\u0435
    \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435, \u0441\u043A\u043B\u043E\u043D\u043D\u044B
    \u043A \u043E\u0431\u043C\u0430\u043D\u0443, \u043C\u0430\u043D\u0438\u043F\u0443\u043B\u044F\u0446\u0438\u0438
    \u0438 \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043D\u044B\u043C \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F\u043C.
    \u0418\u043C \u0442\u0440\u0443\u0434\u043D\u043E \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u0435 \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0435
    \u0441\u0432\u044F\u0437\u0438 \u0438 \u0441\u043E\u0431\u043B\u044E\u0434\u0430\u0442\u044C
    \u043E\u0431\u0449\u0435\u043F\u0440\u0438\u043D\u044F\u0442\u044B\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u0430,
    \u0430 \u0442\u0430\u043A\u0436\u0435 \u043E\u043D\u0438 \u0440\u0435\u0434\u043A\u043E
    \u0438\u0441\u043F\u044B\u0442\u044B\u0432\u0430\u044E\u0442 \u0447\u0443\u0432\u0441\u0442\u0432\u043E
    \u0432\u0438\u043D\u044B \u0438\u043B\u0438 \u0440\u0430\u0441\u043A\u0430\u044F\u043D\u0438\u044F
    \u0437\u0430 \u0441\u0432\u043E\u0438 \u043F\u043E\u0441\u0442\u0443\u043F\u043A\u0438. 
    \u0427\u0435\u0440\u0442\u044B \u0430\u043D\u0442\u0438\u0441\u043E\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
    \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F \u0443\u0436\u0435
    \u0432 \u043F\u043E\u0434\u0440\u043E\u0441\u0442\u043A\u043E\u0432\u043E\u043C
    \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435 \u0438 \u043C\u043E\u0433\u0443\u0442
    \u0432\u043A\u043B\u044E\u0447\u0430\u0442\u044C \u0436\u0435\u0441\u0442\u043E\u043A\u043E\u0441\u0442\u044C
    \u043A \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u043C, \u043B\u0436\u0438\u0432\u043E\u0441\u0442\u044C
    \u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B \u0441 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C
    \u0433\u043D\u0435\u0432\u0430."
  - "\u041F\u0441\u0438\u0445\u043E\u043F\u0430\u0442\u0438\u044F \u2014 \u044D\u0442\u043E
    \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438,
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0437\u0443\u044E\u0449\u0435\u0435\u0441\u044F
    \u0445\u0440\u043E\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\u043C
    \u044D\u043C\u043F\u0430\u0442\u0438\u0438, \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439
    \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439
    \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0441\u0442\u044C\u044E \u0438 \u0431\u0435\u0437\u0436\u0430\u043B\u043E\u0441\u0442\u043D\u043E\u0441\u0442\u044C\u044E.
    \r\n\u041F\u0441\u0438\u0445\u043E\u043F\u0430\u0442\u044B \u0447\u0430\u0441\u0442\u043E
    \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u044E\u0442 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u043D\u043E\u0435
    \u043E\u0431\u0430\u044F\u043D\u0438\u0435, \u0447\u0442\u043E \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
    \u0438\u043C \u043C\u0430\u043D\u0438\u043F\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u043B\u044E\u0434\u044C\u043C\u0438 \u0438 \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0442\u044C
    \u0441\u0432\u043E\u0438\u0445 \u0446\u0435\u043B\u0435\u0439 \u0431\u0435\u0437
    \u0447\u0443\u0432\u0441\u0442\u0432\u0430 \u0432\u0438\u043D\u044B \u0438\u043B\u0438
    \u0440\u0430\u0441\u043A\u0430\u044F\u043D\u0438\u044F.  \r\n\u042D\u0442\u043E
    \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u0447\u0430\u0441\u0442\u043E
    \u0438\u043C\u0435\u0435\u0442 \u0433\u0435\u043D\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u0438 \u0441\u0432\u044F\u0437\u0430\u043D\u043E \u0441 \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u044F\u043C\u0438
    \u0432 \u043C\u043E\u0437\u0433\u0435, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
    \u0432 \u0442\u0435\u0445 \u043E\u0431\u043B\u0430\u0441\u0442\u044F\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043E\u0442\u0432\u0435\u0447\u0430\u044E\u0442 \u0437\u0430 \u044D\u043C\u043E\u0446\u0438\u0438
    \u0438 \u043F\u0440\u0438\u043D\u044F\u0442\u0438\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0439."
  - "\u0413\u0435\u0434\u043E\u043D\u0438\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0443\u0431\u0438\u0439\u0446\u0430 \u2014 \u0443\u0431\u0438\u0439\u0446\u0430,
    \u0434\u043B\u044F \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435
    \u0443\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u043C \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u044F
    \u0438\u043B\u0438 \u043D\u0430\u0441\u043B\u0430\u0436\u0434\u0435\u043D\u0438\u044F.
    \r\n\u0422\u0430\u043A\u0438\u0435 \u0443\u0431\u0438\u0439\u0446\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442
    \u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0435
    \u043E\u0442 \u0441\u0430\u043C\u043E\u0433\u043E \u0430\u043A\u0442\u0430 \u043D\u0430\u0441\u0438\u043B\u0438\u044F,
    \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F \u043D\u0430\u0434 \u0436\u0435\u0440\u0442\u0432\u043E\u0439
    \u0438, \u0437\u0430\u0447\u0430\u0441\u0442\u0443\u044E, \u043E\u0442 \u0441\u0442\u0440\u0430\u0445\u0430
    \u0438\u043B\u0438 \u0441\u0442\u0440\u0430\u0434\u0430\u043D\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043E\u043D\u0438 \u043F\u0440\u0438\u0447\u0438\u043D\u044F\u044E\u0442. \r\n\u0418\u0445
    \u043C\u043E\u0442\u0438\u0432\u0430\u0446\u0438\u044F \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0430
    \u043D\u0430 \u0441\u0442\u0440\u0435\u043C\u043B\u0435\u043D\u0438\u0438 \u043A
    \u0447\u0443\u0432\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u044F\u043C,
    \u0438\u043D\u043E\u0433\u0434\u0430 \u0432 \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0438
    \u0441 \u0436\u0435\u043B\u0430\u043D\u0438\u0435\u043C \u0438\u0441\u043F\u044B\u0442\u0430\u0442\u044C
    \u043E\u0441\u0442\u0440\u044B\u0435 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u044F
    \u0438\u043B\u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0432\u043B\u0430\u0441\u0442\u044C
    \u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C."
  - "\u0421\u0438\u043D\u0434\u0440\u043E\u043C \u041A\u0430\u043F\u0433\u0440\u0430
    \u2014 \u044D\u0442\u043E \u0440\u0435\u0434\u043A\u043E\u0435 \u043F\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E, \u043F\u0440\u0438
    \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A
    \u0443\u0431\u0435\u0436\u0434\u0451\u043D, \u0447\u0442\u043E \u0435\u0433\u043E
    \u0431\u043B\u0438\u0437\u043A\u0438\u0435, \u0442\u0430\u043A\u0438\u0435 \u043A\u0430\u043A
    \u0441\u0435\u043C\u044C\u044F \u0438\u043B\u0438 \u0434\u0440\u0443\u0437\u044C\u044F,
    \u0431\u044B\u043B\u0438 \u0437\u0430\u043C\u0435\u043D\u0435\u043D\u044B \u043D\u0430
    \u0441\u0430\u043C\u043E\u0437\u0432\u0430\u043D\u0446\u0435\u0432 \u0438\u043B\u0438
    \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0438. \r\n\u041B\u044E\u0434\u0438
    \u0441 \u044D\u0442\u0438\u043C \u0441\u0438\u043D\u0434\u0440\u043E\u043C\u043E\u043C
    \u0447\u0430\u0441\u0442\u043E \u0432\u044B\u0440\u0430\u0436\u0430\u044E\u0442
    \u043D\u0435\u0434\u043E\u0432\u0435\u0440\u0438\u0435 \u043A \u0442\u0435\u043C,
    \u043A\u0442\u043E \u0438\u043C \u0437\u043D\u0430\u043A\u043E\u043C, \u0438
    \u0441\u0447\u0438\u0442\u0430\u044E\u0442, \u0447\u0442\u043E \u0438\u0445 \u0440\u043E\u0434\u043D\u044B\u0435
    \u0438\u043B\u0438 \u043B\u044E\u0431\u0438\u043C\u044B\u0435 \u0431\u044B\u043B\u0438
    \u043F\u043E\u0434\u043C\u0435\u043D\u0435\u043D\u044B, \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
    \u043D\u0430 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432
    \u0434\u043B\u044F \u0442\u0430\u043A\u0438\u0445 \u0443\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0439. 
    \r\n\u042D\u0442\u043E \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
    \u0441\u0432\u044F\u0437\u0430\u043D\u043E \u0441 \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u044F\u043C\u0438
    \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u044F \u0438 \u043E\u0441\u043E\u0437\u043D\u0430\u043D\u0438\u044F
    \u043B\u0438\u0447\u043D\u043E\u0439 \u0438\u0434\u0435\u043D\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u0438."
  - "\u0414\u0438\u0441\u0441\u043E\u0446\u0438\u0430\u0442\u0438\u0432\u043D\u043E\u0435
    \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438
    (\u0438\u043B\u0438 \u0434\u0438\u0441\u0441\u043E\u0446\u0438\u0430\u0442\u0438\u0432\u043D\u0430\u044F
    \u0438\u0434\u0435\u043D\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u044C) \u2014
    \u044D\u0442\u043E \u043F\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E, \u043F\u0440\u0438
    \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0443 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
    \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0435\u0439
    \u0438\u043B\u0438 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0439 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u044F,
    \u043A\u0430\u0436\u0434\u0430\u044F \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u0438\u043C\u0435\u0435\u0442 \u0441\u0432\u043E\u0438 \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F,
    \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0438 \u043C\u0430\u043D\u0435\u0440\u044B.
    \r\n\u042D\u0442\u043E \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
    \u0447\u0430\u0441\u0442\u043E \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435\u043C \u0442\u044F\u0436\u0451\u043B\u044B\u0445
    \u043F\u0441\u0438\u0445\u043E\u0442\u0440\u0430\u0432\u043C, \u0442\u0430\u043A\u0438\u0445
    \u043A\u0430\u043A \u043D\u0430\u0441\u0438\u043B\u0438\u0435 \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435.
    \r\n\u041B\u044E\u0434\u0438 \u0441 \u0434\u0438\u0441\u0441\u043E\u0446\u0438\u0430\u0442\u0438\u0432\u043D\u044B\u043C
    \u0440\u0430\u0441\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E\u043C
    \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438 \u043C\u043E\u0433\u0443\u0442
    \u043D\u0435 \u043E\u0441\u043E\u0437\u043D\u0430\u0432\u0430\u0442\u044C \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044B
    \u043C\u0435\u0436\u0434\u0443 \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044F\u043C\u0438,
    \u0438 \u043A\u0430\u0436\u0434\u0430\u044F \u0438\u0437 \u043D\u0438\u0445 \u043C\u043E\u0436\u0435\u0442
    \u0432\u0435\u0441\u0442\u0438 \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u0443\u044E
    \u0436\u0438\u0437\u043D\u044C."
  - "\u041D\u0430\u0440\u0446\u0438\u0441\u0441\u0438\u0437\u043C \u2014 \u044D\u0442\u043E
    \u0447\u0435\u0440\u0442\u0430 \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438,
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0437\u0443\u044E\u0449\u0430\u044F\u0441\u044F
    \u0447\u0440\u0435\u0437\u043C\u0435\u0440\u043D\u044B\u043C \u0432\u043E\u0441\u0445\u0438\u0449\u0435\u043D\u0438\u0435\u043C
    \u0441\u043E\u0431\u043E\u0439, \u043F\u043E\u0442\u0440\u0435\u0431\u043D\u043E\u0441\u0442\u044C\u044E
    \u0432 \u0432\u043E\u0441\u0445\u0438\u0449\u0435\u043D\u0438\u0438 \u0438 \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u0438
    \u0441\u0435\u0431\u044F \u043A\u0430\u043A \u0438\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430. \r\n\u041D\u0430\u0440\u0446\u0438\u0441\u0441\u044B
    \u0447\u0430\u0441\u0442\u043E \u0438\u043C\u0435\u044E\u0442 \u0437\u0430\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0435
    \u0447\u0443\u0432\u0441\u0442\u0432\u043E \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u0432\u0430\u0436\u043D\u043E\u0441\u0442\u0438, \u0441\u0442\u0440\u0435\u043C\u044F\u0442\u0441\u044F
    \u043A \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u0438\u044E \u0438 \u0432\u043E\u0441\u0445\u0438\u0449\u0435\u043D\u0438\u044E
    \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0445, \u043D\u043E \u043F\u0440\u0438
    \u044D\u0442\u043E\u043C \u0447\u0430\u0441\u0442\u043E \u043D\u0435\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B
    \u043A \u0438\u0441\u043A\u0440\u0435\u043D\u043D\u0435\u043C\u0443 \u0441\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u044E
    \u0438 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044E \u043A \u0434\u0440\u0443\u0433\u0438\u043C
    \u043B\u044E\u0434\u044F\u043C."
  textsEn:
  - "Antisocial personality disorder (ASPD) is a mental disorder characterized by
    a persistent disregard for the rights of others and social norms.\r\nPeople with
    this disorder often exhibit aggressive, impulsive behavior, and are prone to
    deception, manipulation, and criminal acts. \r\nThey have difficulty forming
    stable emotional bonds and abiding by accepted rules, and they rarely feel guilt
    or remorse for their actions.  Traits of antisocial disorder begin to appear
    as early as adolescence and may include animal cruelty, lying, and anger control
    problems."
  - "Psychopathy is a personality disorder characterized by a chronic lack of empathy,
    deep emotional coldness, and ruthlessness. \r\nPsychopaths often display a superficial
    charm that helps them manipulate people and achieve their goals without guilt
    or remorse.  \r\nThis disorder is often genetic in origin and is associated with
    abnormalities in the brain, especially in the areas responsible for emotions
    and decision-making."
  - "A hedonistic killer is a killer for whom the act of killing is a source of pleasure
    or enjoyment. \r\nSuch killers derive satisfaction from the act of violence itself,
    from controlling the victim and, often, from the fear or suffering they cause.
    Their motivation is based on the pursuit of sensual pleasures, sometimes combined
    with a desire for thrills or power and control."
  - "Capgras syndrome is a rare mental disorder in which a person is convinced that
    loved ones, such as family or friends, have been replaced by imposters or fakes.
    \r\nPeople with this syndrome often express distrust of those they know and believe
    that their family or loved ones have been replaced, despite a lack of evidence
    for such claims.  \r\nThis disorder is associated with impaired perception and
    awareness of personal identity."
  - "Dissociative identity disorder (or dissociative identity) is a mental disorder
    in which a person develops several different personalities or states of consciousness,
    each with different memories, behaviors, and mannerisms. \r\nThis disorder is
    often the result of severe psychological trauma, such as childhood abuse. \r\nPeople
    with dissociative identity disorder may not realize the transitions between personalities,
    and each may lead independent lives."
  - "Narcissism is a personality trait characterized by excessive admiration for
    oneself, the need for admiration and the perception of oneself as an exceptional
    person. \r\nNarcissists often have an inflated sense of self-importance, seek
    recognition and admiration from others, but are often incapable of genuine empathy
    and consideration for others."
  totalShowTime: 15
