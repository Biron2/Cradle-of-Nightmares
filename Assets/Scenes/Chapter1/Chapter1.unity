  m_GameObject: {fileID: 656416522}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d0f3ddb1f3441c649bcad2f758a016b4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  language: 0
  text:
  - 'Today was a glorious May day. After a delicious breakfast of scrambled eggs
    with bacon and a glass of strong black coffee, I decided to make some changes
    to the outdated interior of the living room.

    I decided to replace the trophy
    heads of the beasts I felled on the hunt with the faces of my beautiful ladies
    I dug up in the cemetery. A fine ensemble of a dead man''s troupe, hehe!

    I
    wondered which of them looked most like my mother. Agusta...Most like her is
    that lady with the blue earrings, I will raise her above all of them, in second
    place would be that gorgeous lady with the green face. The least like my mother
    is this yellow like lemon aunt.....'
  - "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0432\u044B\u0434\u0430\u043B\u0441\u044F
    \u0441\u043B\u0430\u0432\u043D\u044B\u0439 \u043C\u0430\u0439\u0441\u043A\u0438\u0439 
    \u0434\u0435\u043D\u044C. \u041F\u043E\u0437\u0430\u0432\u0442\u0440\u0430\u043A\u0430\u0432
    \u0432\u043A\u0443\u0441\u043D\u0435\u0439\u0448\u0435\u0439 \u044F\u0438\u0447\u043D\u0438\u0446\u0435\u0439
    \u0441 \u0431\u0435\u043A\u043E\u043D\u043E\u043C \u0438 \u0441\u0442\u0430\u043A\u0430\u043D\u043E\u043C
    \u043A\u0440\u0435\u043F\u043A\u043E\u0433\u043E \u0447\u0435\u0440\u043D\u043E\u0433\u043E
    \u043A\u043E\u0444\u0435, \u044F \u0440\u0435\u0448\u0438\u043B \u043F\u0440\u0438\u0432\u043D\u0435\u0441\u0442\u0438
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u0432 \u0443\u0441\u0442\u0430\u0440\u0435\u0432\u0448\u0438\u0439
    \u0438\u043D\u0442\u0435\u0440\u044C\u0435\u0440 \u0433\u043E\u0441\u0442\u0438\u043D\u043E\u0439.\r\n\u042F
    \u0440\u0435\u0448\u0438\u043B \u0437\u0430\u043C\u0435\u043D\u0438\u0442\u044C
    \u0442\u0440\u043E\u0444\u0435\u0439\u043D\u044B\u0435 \u0433\u043E\u043B\u043E\u0432\u044B
    \u0437\u0432\u0435\u0440\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u044F \u043F\u043E\u0432\u0430\u043B\u0438\u043B \u043D\u0430 \u043E\u0445\u043E\u0442\u0435
    \u043D\u0430 \u043B\u0438\u043A\u0438 \u043C\u043E\u0438\u0445 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0445
    \u0434\u0430\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u044F \u0432\u044B\u043A\u043E\u043F\u0430\u043B
    \u043D\u0430 \u043A\u043B\u0430\u0434\u0431\u0438\u0449\u0435. \u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439
    \u0430\u043D\u0441\u0430\u043C\u0431\u043B\u044C \u043C\u0435\u0440\u0442\u0432\u0435\u0446\u043A\u043E\u0439
    \u0442\u0440\u0443\u043F\u043F\u044B, \u0445\u0435-\u0445\u0435!\r\n\u0422\u0443\u0442
    \u044F \u0437\u0430\u0434\u0443\u043C\u0430\u043B\u0441\u044F, \u043A\u0442\u043E
    \u0436\u0435 \u0438\u0437 \u043D\u0438\u0445 \u0431\u043E\u043B\u044C\u0448\u0435
    \u0432\u0441\u0435\u0433\u043E \u043F\u043E\u0445\u043E\u0436 \u043D\u0430 \u043C\u043E\u044E
    \u043C\u0430\u0442\u044C.. \u0410\u0433\u0443\u0441\u0442\u0430...\u0411\u043E\u043B\u044C\u0448\u0435
    \u0432\u0441\u0435\u0433\u043E \u043D\u0430 \u043D\u0435\u0435 \u043F\u043E\u0445\u043E\u0436\u0430
    \u044D\u0442\u0430 \u0434\u0430\u043C\u0430 \u0441 \u0441\u0438\u043D\u0438\u043C\u0438
    \u0441\u0435\u0440\u044C\u0433\u0430\u043C\u0438, \u0435\u0435 \u044F \u043F\u043E\u0434\u043D\u0438\u043C\u0443
    \u0432\u044B\u0448\u0435 \u0432\u0441\u0435\u0445, \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u043C
    \u043C\u0435\u0441\u0442\u0435 \u0431\u0443\u0434\u0435\u0442 \u044D\u0442\u0430
    \u0440\u043E\u0441\u043A\u043E\u0448\u043D\u0430\u044F \u0434\u0430\u043C\u0430
    \u0441 \u0437\u0435\u043B\u0435\u043D\u044B\u043C \u043B\u0438\u0446\u043E\u043C.
    \u041C\u0435\u043D\u044C\u0448\u0435 \u0432\u0441\u0435\u0433\u043E \u043D\u0430
    \u043C\u043E\u044E \u043C\u0430\u0442\u044C \u043F\u043E\u0445\u043E\u0436\u0430
    \u044D\u0442\u0430 \u0436\u0435\u043B\u0442\u0430\u044F \u043A\u0430\u043A \u043B\u0438\u043C\u043E\u043D
    \u0442\u0435\u0442\u043A\u0430..."
