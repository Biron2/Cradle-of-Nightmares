  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 2100000, guid: 94c5cf3eb7809fb44a77e275a77c1c6e, type: 2}
  m_Color: {r: 0, g: 0, b: 0, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 41ba8a42b9fc7db4fbc4a071e0dc473a, type: 3}
    m_FontSize: 30
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 3
    m_MaxSize: 300
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 0.78
  m_Text: 'Today was a glorious May day. After a delicious breakfast of scrambled
    eggs with bacon and a glass of strong black coffee, I decided to make some changes
    to the outdated interior of the living room.

    I decided to replace the trophy
    heads of the beasts I felled on the hunt with the faces of my beautiful ladies
    I dug up in the cemetery. A fine ensemble of a dead man''s troupe, hehe!

    I
    wondered which of them looked most like my mother. Agusta...Most like her is
    that lady with the blue earrings, I will raise her above all of them, in second
    place would be that gorgeous lady with the green face. The least like my mother
    is this yellow like lemon aunt.....'
