--- !u!114 &1630439579
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1630439575}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d0f3ddb1f3441c649bcad2f758a016b4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  language: 0
  text:
  - 'What''s    been going on

    that''s be en going on lately. Today, sitting
    in the tavern, I heard a story about the neighborhood children of the Clegane
    family. Grigor, little Sandor''s older brother, had his brother face down in
    the fire. For what, I ask you?  For taking one of his toys without asking permission!
    Now the poor guy will have this huge scar for the rest of his life.

    How
    cruel people are these days, and it''s only children! Not like me, digging up
    the graves of women who remind me of my mother Agusta at night and making products
    from their dead bodies, hehehe.'
  - "\u0427\u0442\u043E \u0437\u0430     \u0441\u043A\u0432\u0435\u0440\u043D\u044B\u0435
    \u0434\u0435\u043B\u0430\n\u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434 \u044F\u0442
    \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0440\u0435\u043C\u044F.
    \u0421\u0435\u0433\u043E\u0434\u043D\u044F, \u0441\u0438\u0434\u044F \u0432 \u043A\u0430\u0431\u0430\u043A\u0435,
    \u044F \u0443\u0441\u043B\u044B\u0448\u0430\u043B \u0438\u0441\u0442\u043E\u0440\u0438\u044E
    \u043E \u0441\u043E\u0441\u0435\u0434\u0441\u043A\u0438\u0445 \u0434\u0435\u0442\u044F\u0445
    \u0438\u0437 \u0441\u0435\u043C\u0435\u0439\u043A\u0438 \u041A\u043B\u0438\u0433\u0430\u043D\u043E\u0432.
    \u0413\u0440\u0438\u0433\u043E\u0440, \u0441\u0442\u0430\u0440\u0448\u0438\u0439
    \u0431\u0440\u0430\u0442 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0433\u043E
    \u0421\u0430\u043D\u0434\u043E\u0440\u0430, \u0441\u0443\u043D\u0443\u043B \u0441\u0432\u043E\u0435\u0433\u043E 
    \u0431\u0440\u0430\u0442\u0430 \u043B\u0438\u0446\u043E\u043C \u0432 \u043E\u0433\u043E\u043D\u044C.
    \u0417\u0430 \u0447\u0442\u043E \u0436\u0435, \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u044E
    \u044F?  \u0417\u0430 \u0442\u043E, \u0447\u0442\u043E \u0442\u043E\u0442 \u0432\u0441\u0435\u0433\u043E
    \u043B\u0438\u0448\u044C  \u0432\u0437\u044F\u043B \u043E\u0434\u043D\u0443 \u0438\u0437
    \u0435\u0433\u043E \u0438\u0433\u0440\u0443\u0448\u0435\u043A, \u043D\u0435 \u0441\u043F\u0440\u043E\u0441\u0438\u0432
    \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F! \u0422\u0435\u043F\u0435\u0440\u044C
    \u0431\u0435\u0434\u043D\u044F\u0433\u0430 \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C
    \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u0441 \u044D\u0442\u0438\u043C
    \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u043C \u0448\u0440\u0430\u043C\u043E\u043C.\n\u041A\u0430\u043A\u0438\u0435
    \u0436\u0435\u0441\u0442\u043E\u043A\u0438\u0435  \u043B\u044E\u0434\u0438 \u043F\u043E\u0448\u043B\u0438
    \u0432 \u043D\u0430\u0448\u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u0430, \u0438
    \u044D\u0442\u043E \u0432\u0441\u0435\u0433\u043E \u043B\u0438\u0448\u044C \u0434\u0435\u0442\u0438!
    \u041D\u0435 \u0442\u043E \u0447\u0442\u043E \u044F, \u043F\u043E \u043D\u043E\u0447\u0430\u043C
    \u043E\u0442\u043A\u0430\u043F\u044B\u0432\u0430\u044E\u0449\u0438\u0439 \u043C\u043E\u0433\u0438\u043B\u044B
    \u0436\u0435\u043D\u0449\u0438\u043D, \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0449\u0438\u0445
    \u043C\u043D\u0435 \u043C\u043E\u044E \u043C\u0430\u0442\u044C \u0410\u0433\u0443\u0441\u0442\u0443
    \u0438 \u0438\u0437\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0449\u0438\u0439
    \u0438\u0437\u0434\u0435\u043B\u0438\u044F \u0438\u0437 \u0438\u0445 \u043C\u0435\u0440\u0442\u0432\u044B\u0445
    \u0442\u0435\u043B\u0435\u0441, \u0445\u0435-\u0445\u0435."
