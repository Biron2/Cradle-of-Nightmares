--- !u!114 &1267739419
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1267739414}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d0f3ddb1f3441c649bcad2f758a016b4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  language: 0
  text:
  - 'Rapid heartbeat causes heavy and loud breathing,

    which will make the Deviant
    hear and find you.


    To avoid this, press LMB in time

    when the marker
    reaches the scale.'
  - "\u0423\u0447\u0430\u0449\u0435\u043D\u043D\u043E\u0435 \u0441\u0435\u0440\u0434\u0446\u0435\u0431\u0438\u0435\u043D\u0438\u0435
    \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442 \u0443\u0441\u0438\u043B\u0435\u043D\u043D\u043E\u0435
    \u0438\n\u0433\u0440\u043E\u043C\u043A\u043E\u0435 \u0434\u044B\u0445\u0430\u043D\u0438\u0435,
    \u0438\u0437-\u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0414\u0435\u0432\u0438\u0430\u043D\u0442
    \n\u0432\u0430\u0441 \u0443\u0441\u043B\u044B\u0448\u0438\u0442 \u0438 \u043D\u0430\u0439\u0434\u0435\u0442.\n\n\u0427\u0442\u043E\u0431\u044B
    \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C \u044D\u0442\u043E\u0433\u043E,
    \u0432\u043E\u0432\u0440\u0435\u043C\u044F \u043D\u0430\u0436\u0438\u043C\u0430\u0439\u0442\u0435
    \u043D\u0430 \u041B\u041A\u041C,\n\u043A\u043E\u0433\u0434\u0430 \u043E\u0442\u043C\u0435\u0442\u043A\u0430
    \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442 \u0448\u043A\u0430\u043B\u044B."
