  m_Name: 
  m_EditorClassIdentifier: 
  language: 0
  text:
  - 'This content contains violent and frightening scenes,

    scenes of violence
    and cruelty, black humor and profanity.

    The game is not recommended for
    minors and persons with a weak psyche,

    as well as some other categories
    of persons.'
  - "\u0414\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u043D\u0442\u0435\u043D\u0442
    \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u0440\u0435\u0437\u043A\u0438\u0435
    \u043F\u0443\u0433\u0430\u044E\u0449\u0438\u0435 \u0441\u0446\u0435\u043D\u044B,\n\u0441\u0446\u0435\u043D\u044B
    \u043D\u0430\u0441\u0438\u043B\u0438\u044F \u0438 \u0436\u0435\u0441\u0442\u043E\u043A\u043E\u0441\u0442\u0438,
    \u0447\u0435\u0440\u043D\u044B\u0439 \u044E\u043C\u043E\u0440 \u0438 \u043D\u0435\u0446\u0435\u043D\u0437\u0443\u0440\u043D\u0443\u044E
    \u043B\u0435\u043A\u0441\u0438\u043A\u0443.\n\u0418\u0433\u0440\u0430 \u043D\u0435
    \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F
    \u043D\u0435\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E\u043B\u0435\u0442\u043D\u0438\u043C
    \u043B\u0438\u0446\u0430\u043C \u0438 \u043B\u0438\u0446\u0430\u043C \u0441\u043E
    \u0441\u043B\u0430\u0431\u043E\u0439 \u043F\u0441\u0438\u0445\u0438\u043A\u043E\u0439,\n\u0430
    \u0442\u0430\u043A\u0436\u0435 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u043C
    \u0434\u0440\u0443\u0433\u0438\u043C \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u044F\u043C
    \u043B\u0438\u0446."
